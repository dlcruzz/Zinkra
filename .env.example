# Para desenvolvimento local com Vercel Dev (vercel dev):
# A variável abaixo NÃO precisa do prefixo VITE_ — ela roda apenas no servidor
PROPOSALS_PASSWORD=sua-senha-aqui

# Para desenvolvimento local SEM Vercel Dev (npm run dev):
# Crie um .env.local com a variável abaixo como fallback client-side:
VITE_PROPOSALS_PASSWORD=sua-senha-aqui

# ---------------- ERP Zinkra (/erp) ----------------
# Supabase → Project Settings → API. A anon key é pública por natureza (o acesso é protegido pelo RLS).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Só no servidor (Vercel), NUNCA com prefixo VITE_:
# para convidar usuários pelo ERP
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# opcional: assistente com IA na tela Inteligência
ANTHROPIC_API_KEY=
