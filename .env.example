# Formulário de contato (rota /api/contato). Crie a chave em https://resend.com
RESEND_API_KEY=
# Para onde os pedidos chegam
CONTACT_TO_EMAIL=contato@zinkra.com.br
# Remetente verificado no Resend (ex.: "Zinkra <site@zinkra.com.br>").
# Sem domínio verificado, use "Zinkra <onboarding@resend.dev>" para testar.
CONTACT_FROM_EMAIL=Zinkra <onboarding@resend.dev>
# Endereço público do site (usado em sitemap, Open Graph e dados estruturados)
NEXT_PUBLIC_SITE_URL=https://zinkra.com.br
